# ── VM ────────────────────────────────────────────────────────────────────────
# Single source of truth for the Multipass VM address.
# Run `multipass info <vm-name>` to get the current IP after each restart.
VM_IP=192.168.x.x

# All RYU REST URLs are derived automatically from VM_IP.
# Override only if your setup requires different endpoints:
# RYU_REST_URL=http://192.168.x.x:8080
# RYU_REST_PORT=8080
# ADD_URL=http://192.168.x.x:8080/stats/flowentry/add
# DEL_URL=http://192.168.x.x:8080/stats/flowentry/delete

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── Experiment ────────────────────────────────────────────────────────────────
EXPERIMENT_RUNTIME=120
NUM_SWITCHES=3
NUM_HOSTS=5
ANOMALY_CHECK_INTERVAL=30

# ── GUI ───────────────────────────────────────────────────────────────────────
REFRESH_SEC=1

# ── Advanced (optional) ───────────────────────────────────────────────────────
# SLICE_CACHE_TTL_S=4
# LLM_FULL_STATE_REFRESH_EVERY=0
# SLICE_RECENT_FLOWS_LIMIT=3
# METRICS_FILE=data/metrics.json
# LLM_CALLS_LOG_FILE=data/llm_calls.jsonl
